# Section 1.3, technique 2 : isolation du reseau ADMIN par private VLAN
# Le switch decide selon le type du port d'entree de la trame :
#  - port promiscuous : la trame peut sortir vers n'importe quel port
#  - port isole : la trame ne peut sortir que vers un port promiscuous

# Grille racine : ports promiscuous en haut, switch au milieu, ports isoles en bas
grid-rows: 3
grid-gap: 90

classes: {
  promiscuous: {
    style: {fill: "#E1F5EE"; stroke: "#0F6E56"; border-radius: 6; font-size: 15}
  }
  isole: {
    style: {fill: "#FFFFFF"; stroke: "#5F5E5A"; border-radius: 6; font-size: 15}
  }
  groupe: {
    style: {fill: transparent; stroke-dash: 4; border-radius: 10}
  }
  cable: {
    style: {stroke: "#888780"}
  }
  transmise: {
    style: {stroke: "#3B6D11"; stroke-width: 2; font-color: "#3B6D11"; font-size: 13}
  }
  jetee: {
    style: {stroke: "#A32D2D"; stroke-width: 2; stroke-dash: 5; font-color: "#A32D2D"; font-size: 13}
  }
}

# Machines sur des ports promiscuous : elles peuvent joindre tout le monde
promiscuous: Ports promiscuous {
  class: groupe
  label.near: top-left
  grid-columns: 2
  grid-gap: 60
  bastion: "BASTION\n192.168.0.1" {class: promiscuous}
  supervision: "SUPERVISION\n192.168.0.2" {class: promiscuous}
}

switch: "Switch ou bridge ADMIN (private VLAN)" {
  width: 620
  height: 60
  style: {fill: "#E6F1FB"; stroke: "#185FA5"; font-size: 16; bold: true; border-radius: 4}
}

# Machines sur des ports isoles : elles ne se voient pas entre elles
isoles: Ports isolés {
  class: groupe
  label.near: top-left
  grid-columns: 3
  grid-gap: 60
  rp0: "R-PROXY-0\n192.168.0.10" {class: isole}
  ap0: "APPLI-0\n192.168.0.30" {class: isole}
  db0: "DB-0\n192.168.0.20" {class: isole}
}

# Raccordements sans trafic illustre
promiscuous.supervision -- switch {class: cable}
switch -- isoles.ap0 {class: cable}

# Exemple 1 : le bastion envoie une trame vers DB-0, elle entre par un port promiscuous et est transmise
promiscuous.bastion -> switch: "trame vers DB-0" {class: transmise}
switch -> isoles.db0: "transmise" {class: transmise}

# Exemple 2 : R-PROXY-0 envoie une trame vers DB-0, elle entre par un port isole et est jetee
isoles.rp0 -> switch: "trame vers DB-0 : jetée" {class: jetee}
